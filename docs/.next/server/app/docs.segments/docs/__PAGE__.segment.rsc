<span class="line"><span style="color:#666666">});</span></span>
<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">client</span><span style="color:#666666"> =</span><span style="color:#80A665"> createClient</span><span style="color:#666666">({</span></span>
<span class="line"><span style="color:#B8A965">  provider</span><span style="color:#666666">: </span><span style="color:#80A665">anthropic</span><span style="color:#666666">({ </span><span style="color:#B8A965">apiKey</span><span style="color:#666666">: </span><span style="color:#BD976A">process</span><span style="color:#666666">.</span><span style="color:#BD976A">env</span><span style="color:#666666">.</span><span style="color:#BD976A">ANTHROPIC_API_KEY</span><span style="color:#666666"> }),</span></span>
<span class="line"><span style="color:#666666">});</span></span>
