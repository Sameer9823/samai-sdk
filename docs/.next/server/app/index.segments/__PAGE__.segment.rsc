28:T1873,<pre class="shiki vitesse-dark" style="background-color:#121212;color:#dbd7caee" tabindex="0"><code><span class="line"><span style="color:#4D9375">import</span><span style="color:#666666"> {</span><span style="color:#BD976A"> createClient</span><span style="color:#666666">,</span><span style="color:#BD976A"> anthropic</span><span style="color:#666666">,</span><span style="color:#BD976A"> defineAgent</span><span style="color:#666666">,</span><span style="color:#BD976A"> defineTool</span><span style="color:#666666">,</span><span style="color:#BD976A"> runAgent</span><span style="color:#666666"> }</span><span style="color:#4D9375"> from</span><span style="color:#C98A7D77"> "</span><span style="color:#C98A7D">samai-sdk</span><span style="color:#C98A7D77">"</span><span style="color:#666666">;</span></span>
<span class="line"><span style="color:#4D9375">import</span><span style="color:#666666"> {</span><span style="color:#BD976A"> z</span><span style="color:#666666"> }</span><span style="color:#4D9375"> from</span><span style="color:#C98A7D77"> "</span><span style="color:#C98A7D">zod</span><span style="color:#C98A7D77">"</span><span style="color:#666666">;</span></span>
<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">client</span><span style="color:#666666"> =</span><span style="color:#80A665"> createClient</span><span style="color:#666666">({</span></span>
<span class="line"><span style="color:#B8A965">  provider</span><span style="color:#666666">: </span><span style="color:#80A665">anthropic</span><span style="color:#666666">({ </span><span style="color:#B8A965">apiKey</span><span style="color:#666666">: </span><span style="color:#BD976A">process</span><span style="color:#666666">.</span><span style="color:#BD976A">env</span><span style="color:#666666">.</span><span style="color:#BD976A">ANTHROPIC_API_KEY</span><span style="color:#666666"> }),</span></span>
<span class="line"><span style="color:#666666">});</span></span>
<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">getWeather</span><span style="color:#666666"> =</span><span style="color:#80A665"> defineTool</span><span style="color:#666666">({</span></span>
<span class="line"><span style="color:#B8A965">  name</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">get_weather</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  description</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">Get the current weather for a city</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  parameters</span><span style="color:#666666">: </span><span style="color:#BD976A">z</span><span style="color:#666666">.</span><span style="color:#80A665">object</span><span style="color:#666666">({ </span><span style="color:#B8A965">city</span><span style="color:#666666">: </span><span style="color:#BD976A">z</span><span style="color:#666666">.</span><span style="color:#80A665">string</span><span style="color:#666666">() }),</span></span>
<span class="line"><span style="color:#80A665">  execute</span><span style="color:#666666">: </span><span style="color:#CB7676">async</span><span style="color:#666666"> ({ </span><span style="color:#BD976A">city</span><span style="color:#666666"> }) => </span><span style="color:#C98A7D77">`</span><span style="color:#C98A7D">18°C and cloudy in </span><span style="color:#4D9375">${</span><span style="color:#C98A7D">city</span><span style="color:#4D9375">}</span><span style="color:#C98A7D77">`</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#666666">});</span></span>
<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">agent</span><span style="color:#666666"> =</span><span style="color:#80A665"> defineAgent</span><span style="color:#666666">({</span></span>
<span class="line"><span style="color:#B8A965">  name</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">weather_agent</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  instructions</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">Answer weather questions using get_weather.</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  model</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">claude-sonnet-4-6</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  tools</span><span style="color:#666666">: [</span><span style="color:#BD976A">getWeather</span><span style="color:#666666">],</span></span>
<span class="line"><span style="color:#666666">});</span></span>
<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">result</span><span style="color:#666666"> =</span><span style="color:#4D9375"> await</span><span style="color:#80A665"> runAgent</span><span style="color:#666666">(</span><span style="color:#BD976A">client</span><span style="color:#666666">,</span><span style="color:#BD976A"> agent</span><span style="color:#666666">,</span><span style="color:#C98A7D77"> "</span><span style="color:#C98A7D">What's the weather in Nairobi?</span><span style="color:#C98A7D77">"</span><span style="color:#666666">);</span></span>
