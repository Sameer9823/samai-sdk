<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">session</span><span style="color:#666666"> =</span><span style="color:#80A665"> createSession</span><span style="color:#666666">(</span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">user-123</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span><span style="color:#CB7676"> new </span><span style="color:#80A665">InMemorySessionStore</span><span style="color:#666666">());</span></span>
<span class="line"></span>
