orySessionStore());\n\nconst memory = enableGraphMemory({\n  client,\n  creds: { uri: process.env.NEO4J_URI!, username: process.env.NEO4J_USERNAME!, password: process.env.NEO4J_PASSWORD! },\n  userId: \"user-123\",\n  session,\n}).build();\n\nconst assistant = defineAgent({\n  name: \"assistant\",\n  instructions: \"You are a helpful assistant.\",\n  model: \"claude-sonnet-4-6\",\n});\n\nawait ensureGraphConstraints(await memory.driverPromise); // once at startup, idempotent\nmemory.start(); // background sweep begins (default every 3 min)\n\nconst result = await chatWithMemory(client, assistant, memory, \"Planning a trip to Kyoto next month.\", { session });"}]]}],["$","div",null,{"className":"max-w-full overflow-x-auto p-3 text-[12.5px] leading-[1.7] [&_pre]:!bg-transparent sm:p-4 sm:text-[13px] font-(family-name:--font-code)","style":{"fontFamily":"var(--font-code)"},"dangerouslySetInnerHTML":{"__html":"$29"}}]]}]
