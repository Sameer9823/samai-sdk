<span class="line"></span>
<span class="line"><span style="color:#CB7676">const </span><span style="color:#BD976A">agent</span><span style="color:#666666"> =</span><span style="color:#80A665"> defineAgent</span><span style="color:#666666">({</span></span>
<span class="line"><span style="color:#B8A965">  name</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">coder</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  instructions</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">Write and test code using write_file and execute_code. JavaScript runs as an ES module.</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
<span class="line"><span style="color:#B8A965">  model</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">claude-sonnet-4-6</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
