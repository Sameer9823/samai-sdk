24:["$","p",null,{"children":[["$","code",null,{"children":"WebRTCVoiceTransport"}]," wraps the browser ",["$","code",null,{"children":"RTCPeerConnection"}]," with a Node-compatible mock fallback; ",["$","code",null,{"children":"webrtc-signaling.ts"}]," exposes ",["$","code",null,{"children":"createOffer"}]," /"," ",["$","code",null,{"children":"handleAnswer"}]," / ",["$","code",null,{"children":"handleOffer"}]," / ",["$","code",null,{"children":"addIceCandidate"}]," so you can wire any signaling channel (WebSocket, etc.)."," ",["$","code",null,{"children":"OpenAIRealtimeWebRTCTransport"}]," is the ready-made OpenAI implementation on top of it — it does the SDP offer/answer against ",["$","code",null,{"children":"/v1/realtime/calls"}]," for you, and",["$","code",null,{"children":"stopMediaStream()"}]," releases the microphone when the call ends. All of these, plus",["$","code",null,{"children":"createRealtimeClientSecret"}],", are exported from ",["$","code",null,{"children":"samai-sdk/voice"}],"."]}]
