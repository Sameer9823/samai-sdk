20:["$","p",null,{"children":[["$","code",null,{"children":"IntentTracker"}]," persists goal state via the same ",["$","code",null,{"children":"Session"}]," store used for text chat (so voice + text share a store); ",["$","code",null,{"children":"ClarificationPolicy"}]," asks for missing/low-confidence slots before calling the LLM; ",["$","code",null,{"children":"ResponseShaper"}]," trims replies for voice (short inputs → short answers) and optionally emits backchannels on long turns."]}]
