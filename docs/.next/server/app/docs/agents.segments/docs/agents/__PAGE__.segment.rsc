<span class="line"><span style="color:#B8A965">  name</span><span style="color:#666666">: </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">trip_router</span><span style="color:#C98A7D77">"</span><span style="color:#666666">,</span></span>
