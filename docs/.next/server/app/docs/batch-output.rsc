<span class="line"><span style="color:#B8A965">  urgency</span><span style="color:#666666">: </span><span style="color:#BD976A">z</span><span style="color:#666666">.</span><span style="color:#80A665">enum</span><span style="color:#666666">([</span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">low</span><span style="color:#C98A7D77">"</span><span style="color:#666666">, </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">medium</span><span style="color:#C98A7D77">"</span><span style="color:#666666">, </span><span style="color:#C98A7D77">"</span><span style="color:#C98A7D">high</span><span style="color:#C98A7D77">"</span><span style="color:#666666">]),</span></span>
<span class="line"><span style="color:#666666">});</span></span>
<span class="line"></span>
