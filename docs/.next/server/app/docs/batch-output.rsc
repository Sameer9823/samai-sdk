<span class="line"><span style="color:#B8A965">  score</span><span style="color:#666666">: </span><span style="color:#BD976A">v</span><span style="color:#666666">.</span><span style="color:#80A665">pipe</span><span style="color:#666666">(</span><span style="color:#BD976A">v</span><span style="color:#666666">.</span><span style="color:#80A665">number</span><span style="color:#666666">(), </span><span style="color:#BD976A">v</span><span style="color:#666666">.</span><span style="color:#80A665">minValue</span><span style="color:#666666">(</span><span style="color:#4C9A91">1</span><span style="color:#666666">), </span><span style="color:#BD976A">v</span><span style="color:#666666">.</span><span style="color:#80A665">maxValue</span><span style="color:#666666">(</span><span style="color:#4C9A91">10</span><span style="color:#666666">)),</span></span>
