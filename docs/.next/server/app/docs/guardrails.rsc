CostUsd }"}]]}],["$","div",null,{"className":"max-w-full overflow-x-auto p-3 text-[12.5px] leading-[1.7] [&_pre]:!bg-transparent sm:p-4 sm:text-[13px] font-(family-name:--font-code)","style":{"fontFamily":"var(--font-code)"},"dangerouslySetInnerHTML":{"__html":"$1f"}}]]}]
